<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ALARM SOUND -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ALARM SOUND" android:textSize="11sp" android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="0dp"
            app:cardCornerRadius="14dp" app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout android:id="@+id/rowAlarmSound"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Sound" android:textSize="15sp" />
                <TextView android:id="@+id/tvSoundName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="?attr/colorPrimary"
                    android:text="Default Alarm" android:textSize="13sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:layout_marginStart="4dp"
                    android:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VOLUME -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="VOLUME" android:textSize="11sp" android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="0dp"
            app:cardCornerRadius="14dp" app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Alarm Volume" android:textSize="15sp" android:layout_marginBottom="8dp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderVolume" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100"
                    android:stepSize="5" android:value="80" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BEHAVIOUR -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="BEHAVIOUR" android:textSize="11sp" android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="0dp"
            app:cardCornerRadius="14dp" app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp">

                <!-- Vibration -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vibration" android:textSize="15sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchVibration" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

                <!-- Screen Wake -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wake Screen" android:textSize="15sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Turn on screen when alarm triggers" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchScreenWake" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

                <!-- Repeat Alarm -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Repeat Alarm" android:textSize="15sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Repeat alarm 3 times at intervals" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchRepeat" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="?attr/colorOutlineVariant" />

                <!-- Flash -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Flash LED" android:textSize="15sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchFlash" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SNOOZE -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SNOOZE DURATION" android:textSize="11sp" android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSnooze"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipSnooze5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 min" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSnooze10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 min" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSnooze15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 min" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSnooze30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 min" style="@style/Widget.Material3.Chip.Filter" />
        </com.google.android.material.chip.ChipGroup>

        <!-- DO NOT DISTURB -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="DO NOT DISTURB" android:textSize="11sp" android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardElevation="0dp"
            app:cardCornerRadius="14dp" app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Enable DND Schedule" android:textSize="15sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDnd" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:id="@+id/groupDndTimes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="From" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/tvDndStart"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="10:00 PM" style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="–" android:textSize="20sp" android:layout_gravity="center" android:paddingHorizontal="8dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/tvDndEnd"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="7:00 AM" style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ABOUT -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ABOUT" android:textSize="11sp" android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="32dp" app:cardElevation="0dp"
            app:cardCornerRadius="14dp" app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Message Alarm" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Version 1.0.0" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Developed by Adesh Chandra" android:textSize="13sp" android:layout_marginBottom="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiverrLink"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🟢 fiverr.com/adesh_chandra"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
