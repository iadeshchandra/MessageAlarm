<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_bg"
    android:padding="24dp">

    <!-- Top wave animation area -->
    <ImageView
        android:id="@+id/ivWave"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_bell_ring_large"
        android:tint="@color/alarm_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <!-- App Icon -->
    <ImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toBottomOf="@id/ivWave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/alarm_text_secondary"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/ivAppIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="UPWORK" />

    <!-- Best Match Chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipBestMatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ Best Match Job"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"
        app:chipBackgroundColor="@color/upwork_green"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- Notification Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/alarm_text_primary"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/chipBestMatch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="New job match for you!" />

    <!-- Notification Content -->
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/alarm_text_secondary"
        android:gravity="center"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Senior Android Developer needed for a 3-month contract. Matches your profile." />

    <!-- Stop Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Stop Alarm"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toTopOf="@id/btnSnooze"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Snooze Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSnooze"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Snooze"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
