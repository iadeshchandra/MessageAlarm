<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MessageAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MessageAlarm.Alarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alarm_bg</item>
        <item name="android:statusBarColor">@color/alarm_bg</item>
        <item name="android:navigationBarColor">@color/alarm_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
    </style>
</resources>
